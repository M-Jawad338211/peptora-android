{
  "name": "peptora-native",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "prebuild:clean": "expo prebuild --clean",
    "doctor": "npx expo-doctor@latest",
    "bump": "node scripts/bump-build.js",
    "build:android": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=build-artifacts eas build -p android --profile production --local --non-interactive",
    "build:ios": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=build-artifacts eas build -p ios --profile production --local --non-interactive",
    "build:android:apk": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=build-artifacts eas build -p android --profile preview --local --non-interactive",
    "submit:android": "node scripts/submit-latest.js android",
    "submit:ios": "node scripts/submit-latest.js ios",
    "submit:android:eas": "node scripts/submit-latest.js android --eas",
    "submit:ios:eas": "node scripts/submit-latest.js ios --eas",
    "export:web": "expo export -p web",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/query-async-storage-persister": "^5.101.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-persist-client": "^5.101.0",
    "axios": "^1.7.0",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-iap": "5.8.2",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@react-native/jest-preset": "^0.86.3",
    "@types/react": "~19.2.4",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  }
}
